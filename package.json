{
  "name": "promitor",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "wireit",
    "start.server": "wireit",
    "dev": "wireit",
    "build": "wireit",
    "do_install": "wireit",
    "lint": "ng lint"
  },
  "wireit": {
    "do_install": {
      "command": "pm2 start pm2.config.json",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "ng build",
      "dependencies": [
        "build.server"
      ],
      "files": [
        "./projects/StreamDeckApp"
      ],
      "output": [
        "./dist/StreamDeckApp"
      ]
    },
    "start": {
      "command": "node ./dist/server/index/js",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "start.server": {
      "command": "node ./dist/server/index.js",
      "service": true,
      "dependencies": [
        "build.server"
      ]
    },
    "build.server": {
      "command": "tsc -p ./src/tsconfig.json",
      "files": [
        "./src"
      ],
      "output": [
        "./dist/server"
      ]
    },
    "dev": {
      "command": "ng serve --port 4304 --ssl",
      "service": true,
      "dependencies": [
        "start.server"
      ]
    }
  },
  "type": "module",
  "dependencies": {
    "@angular/animations": "^20.3.4",
    "@angular/common": "^20.3.4",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.4",
    "@angular/forms": "^20.3.4",
    "@angular/platform-browser": "^20.3.4",
    "@angular/platform-browser-dynamic": "^20.3.4",
    "@angular/router": "^20.3.4",
    "@elgato-stream-deck/node": "^7.3.3",
    "@google-cloud/text-to-speech": "^6.3.1",
    "@julusian/jpeg-turbo": "^2.3.0",
    "@octokit/rest": "^22.0.0",
    "@types/cors": "^2.8.19",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.15.5",
    "@types/stream-buffers": "^3.0.7",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.18.1",
    "cbor": "^10.0.11",
    "chalk": "^5.6.2",
    "clipboardy": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "i3": "^0.3.0",
    "iconify-icon": "^3.0.1",
    "jsonc": "^2.0.0",
    "mqtt": "^5.14.1",
    "node-fetch": "^3.3.2",
    "node-tradfri-client": "^3.2.0",
    "open": "^10.2.0",
    "pg": "^8.16.3",
    "pureimage": "^0.4.18",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "stream-buffers": "^3.0.3",
    "tslib": "^2.8.1",
    "wireit": "^0.14.12",
    "ws": "^8.18.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.5",
    "@angular-eslint/builder": "20.4.0",
    "@angular-eslint/eslint-plugin": "20.4.0",
    "@angular-eslint/eslint-plugin-template": "20.4.0",
    "@angular-eslint/schematics": "20.4.0",
    "@angular-eslint/template-parser": "20.4.0",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.4",
    "@angular/language-service": "^20.3.4",
    "@types/jasmine": "~5.1.9",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
