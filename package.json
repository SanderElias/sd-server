{
  "name": "promitor",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "wireit",
    "dev": "wireit",
    "build": "wireit",
    "install": "wireit",
    "lint": "ng lint"
  },
  "wireit": {
    "install": {
      "command": "pm2 start pm2.config.json",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "ng build",
      "dependencies": [
        "build.server"
      ],
      "files": [
        "./projects/StreamDeckApp"
      ],
      "output": [
        "./dist/StreamDeckApp"
      ]
    },
    "start": {
      "command": "node ./dist/server/index/js",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "start.server": {
      "command": "node ./dist/server/index.js",
      "service": true,
      "dependencies": [
        "build.server"
      ]
    },
    "build.server": {
      "command": "tsc -p ./src/tsconfig.json",
      "files": [
        "./src"
      ],
      "output": [
        "./dist/server"
      ]
    },
    "dev": {
      "command": "ng serve --port 4304 --ssl",
      "service": true,
      "dependencies": [
        "start.server"
      ]
    }
  },
  "type": "module",
  "dependencies": {
    "@angular/animations": "^18.1.2",
    "@angular/common": "^18.1.2",
    "@angular/compiler": "^18.1.2",
    "@angular/core": "^18.1.2",
    "@angular/forms": "^18.1.2",
    "@angular/platform-browser": "^18.1.2",
    "@angular/platform-browser-dynamic": "^18.1.2",
    "@angular/router": "^18.1.2",
    "@google-cloud/text-to-speech": "^5.3.0",
    "@julusian/jpeg-turbo": "^2.1.0",
    "@octokit/rest": "^20.1.1",
    "@types/cors": "^2.8.17",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.11.6",
    "@types/stream-buffers": "^3.0.7",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.5.10",
    "cbor": "^9.0.2",
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "elgato-stream-deck": "^4.3.0",
    "express": "^4.19.2",
    "i3": "^0.3.0",
    "iconify-icon": "^2.1.0",
    "jsonc": "^2.0.0",
    "mqtt": "^5.6.2",
    "node-fetch": "^3.3.2",
    "node-tradfri-client": "^3.2.0",
    "open": "^10.1.0",
    "pg": "^8.11.5",
    "pureimage": "^0.4.13",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.4",
    "stream-buffers": "^3.0.2",
    "tslib": "^2.6.2",
    "wireit": "^0.14.4",
    "ws": "^8.17.0",
    "zone.js": "~0.14.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.1.2",
    "@angular-eslint/builder": "18.1.0",
    "@angular-eslint/eslint-plugin": "18.1.0",
    "@angular-eslint/eslint-plugin-template": "18.1.0",
    "@angular-eslint/schematics": "18.1.0",
    "@angular-eslint/template-parser": "18.1.0",
    "@angular/cli": "^18.1.2",
    "@angular/compiler-cli": "^18.1.2",
    "@angular/language-service": "^18.1.2",
    "@types/jasmine": "~5.1.4",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "7.10.0",
    "@typescript-eslint/parser": "7.10.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
