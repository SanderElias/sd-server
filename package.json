{
  "name": "promitor",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "wireit",
    "dev": "wireit",
    "build": "wireit",
    "no_install": "wireit",
    "lint": "ng lint"
  },
  "wireit": {
    "install": {
      "command": "pm2 start pm2.config.json",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "ng build",
      "dependencies": [
        "build.server"
      ],
      "files": [
        "./projects/StreamDeckApp"
      ],
      "output": [
        "./dist/StreamDeckApp"
      ]
    },
    "start": {
      "command": "node ./dist/server/index/js",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "start.server": {
      "command": "node ./dist/server/index.js",
      "service": true,
      "dependencies": [
        "build.server"
      ]
    },
    "build.server": {
      "command": "tsc -p ./src/tsconfig.json",
      "files": [
        "./src"
      ],
      "output": [
        "./dist/server"
      ]
    },
    "dev": {
      "command": "ng serve --port 4304 --ssl",
      "service": true,
      "dependencies": [
        "start.server"
      ]
    }
  },
  "type": "module",
  "dependencies": {
    "@angular/animations": "^19.2.3",
    "@angular/common": "^19.2.3",
    "@angular/compiler": "^19.2.3",
    "@angular/core": "^19.2.3",
    "@angular/forms": "^19.2.3",
    "@angular/platform-browser": "^19.2.3",
    "@angular/platform-browser-dynamic": "^19.2.3",
    "@angular/router": "^19.2.3",
    "@google-cloud/text-to-speech": "^6.0.1",
    "@julusian/jpeg-turbo": "^2.2.0",
    "@octokit/rest": "^21.1.1",
    "@types/cors": "^2.8.17",
    "@types/node-fetch": "^2.6.12",
    "@types/pg": "^8.11.11",
    "@types/stream-buffers": "^3.0.7",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.18.0",
    "cbor": "^10.0.3",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "i3": "^0.3.0",
    "iconify-icon": "^2.3.0",
    "jsonc": "^2.0.0",
    "mqtt": "^5.10.4",
    "node-fetch": "^3.3.2",
    "node-tradfri-client": "^3.2.0",
    "open": "^10.1.0",
    "pg": "^8.14.1",
    "pureimage": "^0.4.18",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "stream-buffers": "^3.0.3",
    "tslib": "^2.8.1",
    "wireit": "^0.14.11",
    "ws": "^8.18.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular-eslint/builder": "19.2.1",
    "@angular-eslint/eslint-plugin": "19.2.1",
    "@angular-eslint/eslint-plugin-template": "19.2.1",
    "@angular-eslint/schematics": "19.2.1",
    "@angular-eslint/template-parser": "19.2.1",
    "@angular/cli": "^19.2.4",
    "@angular/compiler-cli": "^19.2.3",
    "@angular/language-service": "^19.2.3",
    "@types/jasmine": "~5.1.7",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^22.13.11",
    "@typescript-eslint/eslint-plugin": "8.27.0",
    "@typescript-eslint/parser": "8.27.0",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
