{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "StreamDeckApp": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/StreamDeckApp",
      "sourceRoot": "projects/StreamDeckApp/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/StreamDeckApp"
            },
            "index": "projects/StreamDeckApp/src/index.html",
            "polyfills": [],
            "tsConfig": "projects/StreamDeckApp/tsconfig.app.json",
            "assets": ["projects/StreamDeckApp/src/favicon.ico", "projects/StreamDeckApp/src/assets"],
            "styles": ["projects/StreamDeckApp/src/styles.css"],
            "scripts": [],
            "sourceMap": true,
            "optimization": true,
            "aot": true,
            "browser": "projects/StreamDeckApp/src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/StreamDeckApp/src/environments/environment.ts",
                  "with": "projects/StreamDeckApp/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "StreamDeckApp:build",
            "hmr": false
          },
          "configurations": {
            "production": {
              "buildTarget": "StreamDeckApp:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "StreamDeckApp:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/StreamDeckApp/src/test.ts",
            "polyfills": "projects/StreamDeckApp/src/polyfills.ts",
            "tsConfig": "projects/StreamDeckApp/tsconfig.spec.json",
            "karmaConfig": "projects/StreamDeckApp/karma.conf.js",
            "assets": ["projects/StreamDeckApp/src/favicon.ico", "projects/StreamDeckApp/src/assets"],
            "styles": ["projects/StreamDeckApp/src/styles.css"],
            "scripts": []
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "projects/StreamDeckApp/e2e/protractor.conf.js",
            "devServerTarget": "StreamDeckApp:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "StreamDeckApp:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/StreamDeckApp/**/*.ts", "projects/StreamDeckApp/**/*.html"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "1ee7009e-d170-41c6-b965-db7f8b2a7a85",
    "schematicCollections": ["@angular-eslint/schematics"]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
